# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/ravinto.db
# Generate a strong secret, never use this placeholder:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when the API is served over HTTPS
REFRESH_COOKIE_SECURE=false
# Explicit list of allowed origins (wildcards are rejected)
CORS_ORIGINS=http://localhost:3000
# Enable Swagger/OpenAPI only in development
ENABLE_DOCS=false

# Open Food Facts
OFF_API_URL=https://world.openfoodfacts.org/api/v2
